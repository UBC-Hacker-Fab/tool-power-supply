	(text "5 V buck (AP63205, 2 A)"
		(exclude_from_sim no)
		(at 33.274 39.116 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "47834409-c492-4fda-a827-376944e257b2")
	)
	(text "L1 Isat 9.0 A (20% drop), Irms 5.5 A, DCR 38 mOhm max\n5 V at 2 A: ripple about 0.56 A pk-pk at 1.1 MHz, peak about 2.3 A\nAP63205 high-side limit 3.1 A max, so Isat has 2.9x margin\n\nR20 33 mR, dV = I x R at the 5 V rail current:\nidle 0.04 A: 1.3 mV\nspin coater 1.04 A: 34.3 mV\nall taps at peak 1.13 A: 37.3 mV\nall taps at current limit 1.85 A: 61.0 mV (2 A buck limit: 66 mV)\nINA226 shunt range +-81.92 mV = 2.48 A"
		(exclude_from_sim no)
		(at 27.178 82.804 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "59aab12a-77ae-4fc7-86e9-2ef41facf753")
	)
	(text "3.3 V taps A and B (TPS2553, enable pull-up; the tap net is the presence sense)"
		(exclude_from_sim no)
		(at 173.482 155.702 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "6385a93b-dc51-4f76-ab7d-d099d0ca3450")
	)
